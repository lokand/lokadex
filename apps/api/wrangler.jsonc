{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lokadex-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Local development; the production block below points at the real
  // databases (created in Eastern US).
  "d1_databases": [
    {
      "binding": "CORE",
      "database_name": "lokadex-core",
      "database_id": "local-lokadex-core",
      "migrations_dir": "migrations/core"
    },
    {
      "binding": "PLACES_TR",
      "database_name": "lokadex-places-tr",
      "database_id": "local-lokadex-places-tr",
      "migrations_dir": "migrations/places"
    }
  ],
  "vars": { "ENVIRONMENT": "development" },
  "env": {
    // Routes (api. / mcp.) are added once the domain is bought.
    "production": {
      "d1_databases": [
        {
          "binding": "CORE",
          "database_name": "lokadex-core",
          "database_id": "d2fd1160-4f2b-472f-b996-34773d36f5b2",
          "migrations_dir": "migrations/core"
        },
        {
          "binding": "PLACES_TR",
          "database_name": "lokadex-places-tr",
          "database_id": "3f3ca23d-7382-4523-8823-baaf17baa3ae",
          "migrations_dir": "migrations/places"
        }
      ],
      "vars": { "ENVIRONMENT": "production" }
    }
  }
}
