{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lokadex-api",
  "account_id": "aab519b88bd28d659f9823871b87de51",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Local development; the production block below points at the real
  // databases in the Lokadex Cloudflare account (Eastern US).
  "d1_databases": [
    {
      "binding": "CORE",
      "database_name": "lokadex-core",
      "database_id": "local-lokadex-core",
      "migrations_dir": "migrations/core"
    },
    {
      "binding": "PLACES_TR",
      "database_name": "lokadex-places-tr",
      "database_id": "local-lokadex-places-tr",
      "migrations_dir": "migrations/places"
    }
  ],
  "vars": { "ENVIRONMENT": "development" },
  "env": {
    // Routes (api. / mcp.) are added once the domain is bought.
    "production": {
      "d1_databases": [
        {
          "binding": "CORE",
          "database_name": "lokadex-core",
          "database_id": "a52948de-b166-4e78-a22f-e0ed59f90bc1",
          "migrations_dir": "migrations/core"
        },
        {
          "binding": "PLACES_TR",
          "database_name": "lokadex-places-tr",
          "database_id": "97c16f23-1588-4208-aae0-ec56c2cf070c",
          "migrations_dir": "migrations/places"
        }
      ],
      "vars": { "ENVIRONMENT": "production" }
    }
  }
}
